<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Build with dotnet build -c Release -p:GameDir="C:\SPT". GameDir is the SPT folder containing EscapeFromTarkov.exe. To save it locally, copy Directory.Build.local.props.example to Directory.Build.local.props.
    The build writes bin\Release\Aero.Grenade.dll, and Aero.Grenade.Fika.dll (the Fika sync) when GameDir has Fika installed. Add -p:DeployToGame=true to copy them into BepInEx\plugins.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Aero.Grenade</AssemblyName>
    <RootNamespace>Aero.Grenade</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Aero.Grenade</Product>
    <AssemblyTitle>Aero.Grenade</AssemblyTitle>
    <Description>Grenade overhaul for SPT: hold-to-throw, grenade menu, animation speeds, cooking, throw strength and fuse time.</Description>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <ManagedDir>$(GameDir)\EscapeFromTarkov_Data\Managed</ManagedDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
  </PropertyGroup>

  <Target Name="RequireGameDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GameDir)' == ''"
           Text="Set GameDir to your SPT install folder (the one containing EscapeFromTarkov.exe): pass -p:GameDir=... or set it in Directory.Build.local.props." />
    <Error Condition="!Exists('$(ManagedDir)\Assembly-CSharp.dll')"
           Text="GameDir '$(GameDir)' does not contain EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll." />
    <Error Condition="!Exists('$(BepInExDir)\core\BepInEx.dll')"
           Text="GameDir '$(GameDir)' does not contain BepInEx\core\BepInEx.dll." />
  </Target>

  <ItemGroup>
    <Compile Include="Animation\AnimSpeedPatches.cs" />
    <Compile Include="Animation\DeployPinCutIn.cs" />
    <Compile Include="Animation\GrenadeAnim.cs" />
    <Compile Include="ConfigurationManagerAttributes.cs" />
    <Compile Include="Cooking\CookCue.cs" />
    <Compile Include="Cooking\CookFlash.cs" />
    <Compile Include="Cooking\CookPrewarmPatch.cs" />
    <Compile Include="Cooking\CookTwitch.cs" />
    <Compile Include="Cooking\CookTwitchPatch.cs" />
    <Compile Include="Cooking\GrenadeCook.cs" />
    <Compile Include="Diagnostics.cs" />
    <Compile Include="FikaCompat.cs" />
    <Compile Include="FikaLoader.cs" />
    <Compile Include="GrenadeConfig.cs" />
    <Compile Include="Menu\GrenadeMenu.cs" />
    <Compile Include="Menu\SelectorInputPatch.cs" />
    <Compile Include="Physics\FuseTimePatch.cs" />
    <Compile Include="Physics\ThrowStrengthPatch.cs" />
    <Compile Include="Plugin.cs" />
    <Compile Include="Throw\AutoPinPatch.cs" />
    <Compile Include="Throw\GrenadeEquipPatch.cs" />
    <Compile Include="Throw\GrenadeInputManager.cs" />
    <Compile Include="Throw\GrenadeThrowDriver.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(ManagedDir)\UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Comfort"><HintPath>$(ManagedDir)\Comfort.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AnimationSystem.Types"><HintPath>$(ManagedDir)\AnimationSystem.Types.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sirenix.Serialization"><HintPath>$(ManagedDir)\Sirenix.Serialization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="spt-common"><HintPath>$(BepInExDir)\plugins\spt\spt-common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="spt-reflection"><HintPath>$(BepInExDir)\plugins\spt\spt-reflection.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="BuildFikaSync" AfterTargets="Build" Condition="Exists('$(BepInExDir)\plugins\Fika\Fika.Core.dll')">
    <MSBuild Projects="Fika\Aero.Grenade.Fika.csproj" Targets="Restore" Properties="GameDir=$(GameDir);Configuration=$(Configuration);FikaSyncRestore=true" />
    <MSBuild Projects="Fika\Aero.Grenade.Fika.csproj" Targets="Build" Properties="GameDir=$(GameDir);Configuration=$(Configuration)" />
  </Target>

  <Target Name="SkipFikaSync" AfterTargets="Build" Condition="!Exists('$(BepInExDir)\plugins\Fika\Fika.Core.dll')">
    <Message Importance="high" Text="Fika is not installed in GameDir; Aero.Grenade.Fika.dll (the Fika sync) was not built." />
  </Target>

  <Target Name="DeployToGame" AfterTargets="Build" DependsOnTargets="BuildFikaSync" Condition="'$(DeployToGame)' == 'true'">
    <Copy SourceFiles="$(OutputPath)Aero.Grenade.dll" DestinationFolder="$(BepInExDir)\plugins\" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(OutputPath)Aero.Grenade.Fika.dll" DestinationFolder="$(BepInExDir)\plugins\" SkipUnchangedFiles="false" Condition="Exists('$(OutputPath)Aero.Grenade.Fika.dll')" />
  </Target>
</Project>
